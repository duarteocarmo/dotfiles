*

# Track pi extensions
!.pi/
!.pi/agent/
!.pi/agent/extensions/
!.pi/agent/extensions/**/
!.pi/agent/extensions/**/*
.pi/agent/extensions/**/node_modules/

# Track pi MCP servers (URLs only; tokens live in the ignored mcp-auth.json)
!.pi/agent/mcp.json

# Track pi themes
!.pi/agent/themes/
!.pi/agent/themes/**

# Track mise config
!.config/
!.config/mise/
!.config/mise/config.toml

# Track Herdr config
!.config/herdr/
!.config/herdr/config.toml

# Track lazygit config
!Library/
!Library/Application Support/
!Library/Application Support/lazygit/
!Library/Application Support/lazygit/config.yml
